# Local PostgreSQL used only by scripts/verify-db.ts.
# Copy to .env.test.local (git-ignored) and fill in the password you set when
# installing PostgreSQL. This is never used by the app itself -- the Next.js app
# talks to Supabase, not to raw Postgres.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
